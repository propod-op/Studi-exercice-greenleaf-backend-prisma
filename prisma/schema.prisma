generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id        Int      @id @default(autoincrement())
  nom       String
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("utilisateur")
}

model Service {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  prix        Decimal  @db.Decimal(8, 2)
  createdAt   DateTime @default(now())

  @@map("service")
}
